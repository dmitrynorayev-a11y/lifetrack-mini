{
  "name": "vyra-iphone",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "VYRA RPG with Capacitor and Apple HealthKit",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "node --test src/health-logic.test.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "ios:add": "npx cap add ios --packagemanager SPM",
    "ios:sync": "npm run build && npx cap sync ios && node scripts/configure-ios.mjs",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capgo/capacitor-health": "8.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0"
  }
}